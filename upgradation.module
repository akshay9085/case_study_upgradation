<?php

use Drupal\Component\Utility\Html;
use Drupal\Core\Link;
use Drupal\Core\Url;



/**
 * Returns module configuration values.
 */
function upgradation_settings_get($key, $default = '') {
  $value = \Drupal::config('upgradation.settings')->get($key);
  return $value !== NULL ? $value : $default;
}

/**
 * Returns common outbound mail settings.
 */
function upgradation_mail_settings() {
  return [
    'from' => upgradation_settings_get('upgraded_case_study_from_email', ''),
    'bcc' => upgradation_settings_get('upgraded_case_study_emails', ''),
    'cc' => upgradation_settings_get('upgraded_case_study_cc_emails', ''),
  ];
}

/**
 * Sends mail through Drupal's mail manager.
 */
function upgradation_send_mail($module, $key, $email_to, $langcode, array $params = [], $reply = NULL) {
  $result = \Drupal::service('plugin.manager.mail')->mail($module, $key, $email_to, $langcode, $params, $reply, TRUE);
  return !empty($result['result']);
}

/**
 * Implements hook_mail().
 */
function upgradation_mail($key, &$message, $params) {
  $payload = (isset($params[$key]) && is_array($params[$key])) ? $params[$key] : [];

  if (!empty($payload['headers']) && is_array($payload['headers'])) {
    $message['headers'] = array_merge($message['headers'] ?? [], $payload['headers']);
  }

  if ($key === 'standard') {
    $message['subject'] = (string) ($payload['subject'] ?? '');
    $body = $payload['body'] ?? '';
    $message['body'] = is_array($body) ? $body : [(string) $body];
    return;
  }

  $langcode = $message['langcode'] ?? \Drupal::languageManager()->getDefaultLanguage()->getId();
  $site_name = upgradation_site_name();

  $proposal_id = $payload['proposal_id'] ?? $payload['result1'] ?? NULL;
  $proposal = upgradation_load_proposal($proposal_id);

  $account = NULL;
  if (!empty($payload['user_id'])) {
    $account = \Drupal::entityTypeManager()->getStorage('user')->load((int) $payload['user_id']);
  }

  $proposal_user_name = upgradation_proposal_full_name($proposal);
  $user_name = $proposal_user_name !== ''
    ? $proposal_user_name
    : ($account ? $account->getDisplayName() : t('Contributor', [], ['langcode' => $langcode]));
  $user_email = $account ? $account->getEmail() : '';
  $proposal_lines = upgradation_build_common_proposal_lines($proposal, $user_email, $langcode);

  switch ($key) {
    case 'case_study_proposal_received':
      $message['subject'] = t('[@site_name][Case Study Upgradation Project] Your proposal has been received', ['@site_name' => $site_name], ['langcode' => $langcode]);
      $message['body'] = [
        t('Dear @user_name,', ['@user_name' => $user_name], ['langcode' => $langcode]),
        '',
        t('We have received your case study upgradation proposal with the following details:', [], ['langcode' => $langcode]),
      ];
      $message['body'] = array_merge($message['body'], $proposal_lines, [
        '',
        t('Please upload your abstract and project files to complete the submission.', [], ['langcode' => $langcode]),
        '',
        t('Best wishes,', [], ['langcode' => $langcode]),
        '',
        t('@site_name Team', ['@site_name' => $site_name], ['langcode' => $langcode]),
        'FOSSEE, IIT Bombay',
      ]);
      break;

    case 'abstract_uploaded':
      $message['subject'] = t('[@site_name][Case Study Upgradation Project] Project files uploaded', ['@site_name' => $site_name], ['langcode' => $langcode]);
      $message['body'] = [
        t('Dear @user_name,', ['@user_name' => $user_name], ['langcode' => $langcode]),
        '',
        t('You have uploaded files for the following case study upgradation project:', [], ['langcode' => $langcode]),
      ];
      $message['body'] = array_merge($message['body'], $proposal_lines, [
        '',
        t('The files are under review. You will be notified after review.', [], ['langcode' => $langcode]),
        '',
        t('Best wishes,', [], ['langcode' => $langcode]),
        '',
        t('@site_name Team', ['@site_name' => $site_name], ['langcode' => $langcode]),
        'FOSSEE, IIT Bombay',
      ]);
      break;

    case 'abstract_edit_file_uploaded':
      $updated_files = [];
      foreach ((array) ($payload['updated_files'] ?? []) as $file_name) {
        $updated_files[] = upgradation_mail_value($file_name);
      }
      $updated_files_text = $updated_files ? implode(', ', $updated_files) : 'N/A';

      $message['subject'] = t('[@site_name][Case Study Upgradation Project] Project files updated', ['@site_name' => $site_name], ['langcode' => $langcode]);
      $message['body'] = [
        t('Dear @user_name,', ['@user_name' => $user_name], ['langcode' => $langcode]),
        '',
        t('You have updated files for the following case study upgradation project:', [], ['langcode' => $langcode]),
      ];
      $message['body'] = array_merge($message['body'], $proposal_lines, [
        t('Updated Files: @value', ['@value' => $updated_files_text], ['langcode' => $langcode]),
        '',
        t('Best wishes,', [], ['langcode' => $langcode]),
        '',
        t('@site_name Team', ['@site_name' => $site_name], ['langcode' => $langcode]),
        'FOSSEE, IIT Bombay',
      ]);
      break;

    case 'case_study_proposal_completed':
      $message['subject'] = t('[@site_name][Case Study Upgradation Project] Your proposal has been marked as completed', ['@site_name' => $site_name], ['langcode' => $langcode]);
      $message['body'] = [
        t('Dear @user_name,', ['@user_name' => $user_name], ['langcode' => $langcode]),
        '',
        t('Your case study upgradation submission has been marked as completed successfully.', [], ['langcode' => $langcode]),
        '',
      ];
      $message['body'] = array_merge($message['body'], $proposal_lines, [
        '',
        t('Best wishes,', [], ['langcode' => $langcode]),
        '',
        t('@site_name Team', ['@site_name' => $site_name], ['langcode' => $langcode]),
        'FOSSEE, IIT Bombay',
      ]);
      break;

    case 'case_study_proposal_deleted':
      $message['subject'] = t('[@site_name][Case Study Upgradation Project] Your proposal has been deleted', ['@site_name' => $site_name], ['langcode' => $langcode]);
      $message['body'] = [
        t('Dear @user_name,', ['@user_name' => $user_name], ['langcode' => $langcode]),
        '',
        t('Your case study upgradation proposal has been deleted with the following details:', [], ['langcode' => $langcode]),
        '',
      ];
      $message['body'] = array_merge($message['body'], $proposal_lines, [
        '',
        t('You can submit a new case study upgradation proposal anytime.', [], ['langcode' => $langcode]),
        '',
        t('Best wishes,', [], ['langcode' => $langcode]),
        '',
        t('@site_name Team', ['@site_name' => $site_name], ['langcode' => $langcode]),
        'FOSSEE, IIT Bombay',
      ]);
      break;

    default:
      if (isset($payload['subject'])) {
        $message['subject'] = (string) $payload['subject'];
      }
      if (isset($payload['body'])) {
        $message['body'] = is_array($payload['body']) ? $payload['body'] : [(string) $payload['body']];
      }
      break;
  }
}

/**
 * Builds common proposal detail lines for email templates.
 */
function upgradation_build_common_proposal_lines($proposal, $user_email, $langcode) {
  if (!$proposal) {
    return [
      t('Proposal details are unavailable.', [], ['langcode' => $langcode]),
    ];
  }

  $full_name = upgradation_proposal_full_name($proposal);
  $version = !empty($proposal->version_id) ? upgradation_get_version_name($proposal->version_id) : '';
  $creation_date = upgradation_format_mail_date($proposal->creation_date ?? NULL);
  $expected_completion = upgradation_format_mail_date($proposal->expected_date_of_completion ?? NULL);

  return [
    t('Full Name: @value', ['@value' => upgradation_mail_value($full_name)], ['langcode' => $langcode]),
    t('Email: @value', ['@value' => upgradation_mail_value($user_email)], ['langcode' => $langcode]),
    t('University: @value', ['@value' => upgradation_mail_value($proposal->university ?? '')], ['langcode' => $langcode]),
    t('Institute: @value', ['@value' => upgradation_mail_value($proposal->institute ?? '')], ['langcode' => $langcode]),
    t('City: @value', ['@value' => upgradation_mail_value($proposal->city ?? '')], ['langcode' => $langcode]),
    t('State: @value', ['@value' => upgradation_mail_value($proposal->state ?? '')], ['langcode' => $langcode]),
    t('Country: @value', ['@value' => upgradation_mail_value($proposal->country ?? '')], ['langcode' => $langcode]),
    t('Project Title: @value', ['@value' => upgradation_mail_value($proposal->project_title ?? '')], ['langcode' => $langcode]),
    t('Upgraded Version: @value', ['@value' => upgradation_mail_value($version ?: ($proposal->version_id ?? ''))], ['langcode' => $langcode]),
    t('Simulation Type: @value', ['@value' => upgradation_mail_value($proposal->simulation_type_id ?? '')], ['langcode' => $langcode]),
    t('Solver Used: @value', ['@value' => upgradation_mail_value($proposal->solver_used ?? '')], ['langcode' => $langcode]),
    t('Date of Proposal: @value', ['@value' => $creation_date], ['langcode' => $langcode]),
    t('Expected Date of Completion: @value', ['@value' => $expected_completion], ['langcode' => $langcode]),
  ];
}

/**
 * Returns the full contributor name stored on a proposal.
 */
function upgradation_proposal_full_name($proposal) {
  if (!$proposal) {
    return '';
  }

  return trim(($proposal->name_title ?? '') . ' ' . ($proposal->contributor_name ?? ''));
}

/**
 * Formats proposal date values for email templates.
 */
function upgradation_format_mail_date($value) {
  if (empty($value) || !is_numeric($value)) {
    return 'N/A';
  }

  return \Drupal::service('date.formatter')->format((int) $value, 'custom', 'd/m/Y');
}

/**
 * Normalizes mail placeholder values.
 */
function upgradation_mail_value($value) {
  $value = is_string($value) ? trim($value) : $value;
  return ($value === '' || $value === NULL || $value === 'NULL') ? 'N/A' : (string) $value;
}

/**
 * Returns the site name.
 */
function upgradation_site_name() {
  return \Drupal::config('system.site')->get('name') ?: 'Drupal';
}

/**
 * Returns the upload root for case study upgradation files.
 */
function upgradation_path() {
  return DRUPAL_ROOT . '/cfd_uploads/csu_uploads/';
}

/**
 * Validates uploaded file names.
 */
function upgradation_check_valid_filename($file_name) {
  if (!preg_match('/^[0-9a-zA-Z._-]+$/', $file_name)) {
    return FALSE;
  }

  return substr_count($file_name, '.') <= 1;
}

/**
 * Returns a proposal row.
 */
function upgradation_load_proposal($proposal_id) {
  return \Drupal::database()
    ->select('csu_proposal', 'cp')
    ->fields('cp')
    ->condition('id', (int) $proposal_id)
    ->range(0, 1)
    ->execute()
    ->fetchObject();
}

/**
 * Returns the latest proposal for a user.
 */
function upgradation_load_latest_user_proposal($uid) {
  return \Drupal::database()
    ->select('csu_proposal', 'cp')
    ->fields('cp')
    ->condition('uid', (int) $uid)
    ->orderBy('id', 'DESC')
    ->range(0, 1)
    ->execute()
    ->fetchObject();
}

/**
 * Returns the active approved proposal for a user.
 */
function upgradation_load_approved_user_proposal($uid) {
  return \Drupal::database()
    ->select('csu_proposal', 'cp')
    ->fields('cp')
    ->condition('uid', (int) $uid)
    ->condition('approval_status', 1)
    ->orderBy('id', 'DESC')
    ->range(0, 1)
    ->execute()
    ->fetchObject();
}

/**
 * Loads a user entity.
 */
function upgradation_load_user($uid) {
  return \Drupal::entityTypeManager()->getStorage('user')->load((int) $uid);
}

/**
 * Returns the current user's active proposal, if allowed.
 */
function upgradation_get_proposal() {
  $user = \Drupal::currentUser();
  $proposal_data = upgradation_load_latest_user_proposal($user->id());
  if (!$proposal_data) {
    \Drupal::messenger()->addError(t('You do not have any approved Case Study proposal. Please propose a Case Study.'));
    return FALSE;
  }

  switch ((int) $proposal_data->approval_status) {
    case 1:
      return $proposal_data;

    case 2:
      \Drupal::messenger()->addError(t('Proposal has been dis-approved.'));
      return FALSE;

    case 3:
      \Drupal::messenger()->addStatus(t('Proposal has been marked as completed.'));
      return FALSE;

    default:
      \Drupal::messenger()->addError(t('Invalid proposal state. Please contact the site administrator.'));
      return FALSE;
  }
}

/**
 * Returns version options.
 */
function _csu_list_of_versions() {
  $versions = [];
  $result = \Drupal::database()
    ->select('csu_version', 'v')
    ->fields('v', ['id', 'case_study_version'])
    ->orderBy('id', 'ASC')
    ->execute();

  while ($version = $result->fetchObject()) {
    $versions[$version->id] = $version->case_study_version;
  }

  return $versions;
}

/**
 * Returns the upgraded version label for a version id.
 */
function upgradation_get_version_name($version_id) {
  return \Drupal::database()
    ->select('csu_version', 'v')
    ->fields('v', ['case_study_version'])
    ->condition('id', $version_id)
    ->range(0, 1)
    ->execute()
    ->fetchField();
}

/**
 * Returns the original case study version label for a version id.
 */
function upgradation_get_old_version_name($version_id) {
  return \Drupal::database()
    ->select('case_study_software_version', 'v')
    ->fields('v', ['case_study_version'])
    ->condition('id', $version_id)
    ->range(0, 1)
    ->execute()
    ->fetchField();
}

/**
 * Returns the list of original case study titles that can be upgraded.
 */
function _csu_list_of_case_studies($selected_version = NULL) {
  $case_studies = [];
  $query = "SELECT project_title FROM {case_study_proposal}
    WHERE project_title NOT IN (
      SELECT project_title FROM {csu_proposal} WHERE approval_status = 3
    )
    ORDER BY project_title ASC";
  $result = \Drupal::database()->query($query);

  while ($row = $result->fetchObject()) {
    $case_studies[$row->project_title] = $row->project_title;
  }

  return $case_studies;
}

/**
 * Returns solver options for a version id.
 */
function _csu_list_of_solvers($version_id) {
  $solvers = [];
  $result = \Drupal::database()
    ->select('csu_solvers', 's')
    ->fields('s', ['solver_name'])
    ->condition('version_id', $version_id)
    ->orderBy('solver_name', 'ASC')
    ->execute();

  while ($solver = $result->fetchObject()) {
    $solvers[$solver->solver_name] = $solver->solver_name;
  }

  return $solvers;
}

/**
 * Returns simulation types for an original case study title.
 */
function _csu_list_of_simulation_types($project_title = NULL) {
  $simulation_types = [];
  $query = \Drupal::database()
    ->select('case_study_simulation_type', 's')
    ->fields('s', ['simulation_type']);

  if ($project_title !== NULL) {
    $query->innerJoin('case_study_proposal', 'p', 'p.simulation_type_id = s.id');
    $query->condition('p.project_title', $project_title);
  }

  $result = $query->execute();
  while ($row = $result->fetchObject()) {
    $simulation_types[$row->simulation_type] = $row->simulation_type;
  }

  return $simulation_types;
}

/**
 * Builds the directory name for a proposal.
 */
function _csu_dir_name($project, $proposar_name) {
  $directory_name = trim($project . ' By ' . $proposar_name);
  return str_replace(['__', ' ', '/'], ['_', '_', '_'], $directory_name);
}

/**
 * Returns the relative upload path for a proposal.
 */
function upgradation_get_proposal_relative_path($proposal) {
  $version = upgradation_get_version_name($proposal->version_id) ?: $proposal->version_id;
  return $version . '/' . $proposal->simulation_type_id . '/' . $proposal->directory_name . '/';
}

/**
 * Returns the absolute upload path for a proposal.
 */
function upgradation_get_proposal_absolute_path($proposal) {
  return upgradation_path() . upgradation_get_proposal_relative_path($proposal);
}

/**
 * Ensures that the proposal upload directory exists.
 */
function upgradation_ensure_proposal_directory($proposal) {
  $directory = upgradation_get_proposal_absolute_path($proposal);
  if (!is_dir($directory)) {
    mkdir($directory, 0775, TRUE);
  }
  return $directory;
}

/**
 * Returns all uploaded file records for a proposal keyed by type.
 */
function upgradation_get_uploaded_file_records($proposal_id) {
  $records = [];
  $result = \Drupal::database()
    ->select('csu_submitted_abstracts_file', 'f')
    ->fields('f')
    ->condition('proposal_id', (int) $proposal_id)
    ->execute();

  while ($file = $result->fetchObject()) {
    $records[$file->filetype] = $file;
  }

  return $records;
}

/**
 * Returns an uploaded file record by type.
 */
function upgradation_get_uploaded_file_record($proposal_id, $filetype) {
  return \Drupal::database()
    ->select('csu_submitted_abstracts_file', 'f')
    ->fields('f')
    ->condition('proposal_id', (int) $proposal_id)
    ->condition('filetype', $filetype)
    ->range(0, 1)
    ->execute()
    ->fetchObject();
}

/**
 * Returns the submitted abstract record for a proposal.
 */
function upgradation_get_submission_record($proposal_id) {
  return \Drupal::database()
    ->select('csu_submitted_abstracts', 'sa')
    ->fields('sa')
    ->condition('proposal_id', (int) $proposal_id)
    ->range(0, 1)
    ->execute()
    ->fetchObject();
}

/**
 * Returns a default uploaded file placeholder.
 */
function default_value_for_uploaded_files($filetype, $proposal_id) {
  return upgradation_get_uploaded_file_record($proposal_id, $filetype);
}

/**
 * Returns file metadata labels by type.
 */
function upgradation_file_type_labels() {
  return [
    'A' => t('Abstract'),
    'S' => t('Case Directory'),
    'R' => t('All Run file'),
  ];
}

/**
 * Returns allowed extensions for a file type.
 */
function upgradation_allowed_extensions($filetype) {
  switch ($filetype) {
    case 'A':
      return upgradation_settings_get('upgradation_abstract_upload_extensions', '');

    case 'S':
      return upgradation_settings_get('upgraded_case_study_project_files_extensions', '');

    case 'R':
      return upgradation_settings_get('all_run_extensions', '');

    default:
      return '';
  }
}

/**
 * Returns a completed case study list for the public run page.
 */
function _list_of_upgraded_case_study() {
  $case_studies = [0 => t('Please select...')];
  $result = \Drupal::database()
    ->select('csu_proposal', 'cp')
    ->fields('cp', ['id', 'project_title', 'name_title', 'contributor_name'])
    ->condition('approval_status', 3)
    ->orderBy('project_title', 'ASC')
    ->execute();

  while ($row = $result->fetchObject()) {
    $case_studies[$row->id] = $row->project_title . ' (Proposed by ' . $row->name_title . ' ' . $row->contributor_name . ')';
  }

  return $case_studies;
}

/**
 * Returns a completed case study proposal by id.
 */
function _upgraded_case_study_information($proposal_id) {
  $proposal = \Drupal::database()
    ->select('csu_proposal', 'cp')
    ->fields('cp')
    ->condition('id', (int) $proposal_id)
    ->condition('approval_status', 3)
    ->range(0, 1)
    ->execute()
    ->fetchObject();

  return $proposal ?: 'Not found';
}

/**
 * Returns rendered details for the public run page.
 */
function _upgraded_case_study_details($proposal_id) {
  $case_study = _upgraded_case_study_information($proposal_id);
  if (!$proposal_id || $case_study === 'Not found') {
    return '';
  }

  $old_case_study = \Drupal::database()
    ->select('case_study_proposal', 'cp')
    ->fields('cp')
    ->condition('project_title', $case_study->project_title)
    ->range(0, 1)
    ->execute()
    ->fetchObject();

  $old_version = $old_case_study ? (upgradation_get_old_version_name($old_case_study->version_id) ?: $old_case_study->version_id) : '';
  $new_version = upgradation_get_version_name($case_study->version_id) ?: $case_study->version_id;

  $download_links = [];
  if ($old_case_study) {
    $download_links[] = Link::fromTextAndUrl(t('Download the report of the Case Study'), Url::fromUri('https://cfd.fossee.in/case-study-project/download/project-file/' . $old_case_study->id))->toString();
    $download_links[] = Link::fromTextAndUrl(t('Download Case Files of the Original Case Study'), Url::fromUri('https://cfd.fossee.in/case-study-project/full-download/project/' . $old_case_study->id))->toString();
  }
  $download_links[] = Link::fromTextAndUrl(t('Download Upgraded Case Study'), Url::fromRoute('upgradation.download_full_project', ['proposal_id' => $proposal_id]))->toString();

  $markup = '<div class="upgradation-case-study-details">';
  $markup .= '<h3>' . Html::escape($case_study->project_title) . '</h3>';
  if ($old_case_study) {
    $markup .= '<p><strong>' . t('Original Case Study') . ':</strong> ' . Html::escape($old_case_study->name_title . ' ' . $old_case_study->contributor_name) . '</p>';
    $markup .= '<p><strong>' . t('Original Version') . ':</strong> ' . Html::escape($old_version) . '</p>';
    $markup .= '<p><strong>' . t('Original University') . ':</strong> ' . Html::escape($old_case_study->university) . '</p>';
  }
  $markup .= '<p><strong>' . t('Upgraded By') . ':</strong> ' . Html::escape($case_study->name_title . ' ' . $case_study->contributor_name) . '</p>';
  $markup .= '<p><strong>' . t('Upgraded Version') . ':</strong> ' . Html::escape($new_version) . '</p>';
  $markup .= '<p><strong>' . t('University') . ':</strong> ' . Html::escape($case_study->university) . '</p>';
  $markup .= '<p><strong>' . t('Downloads') . ':</strong><br>' . implode('<br>', $download_links) . '</p>';
  $markup .= '</div>';

  return $markup;
}

/**
 * Returns case studies that are ready for bulk review.
 */
function _bulk_list_of_upgradation() {
  $project_titles = [0 => t('Please select...')];
  $result = \Drupal::database()
    ->select('csu_proposal', 'cp')
    ->fields('cp', ['id', 'project_title', 'contributor_name'])
    ->condition('is_submitted', 1)
    ->condition('approval_status', 1)
    ->orderBy('project_title', 'ASC')
    ->execute();
// if (empty($result)){
//   set
// }
  while ($row = $result->fetchObject()) {
    $project_titles[$row->id] = $row->project_title . ' (Proposed by ' . $row->contributor_name . ')';
  }

  return $project_titles;
}

/**
 * Returns bulk action options.
 */
function _bulk_list_case_study_actions() {
  return [
    0 => t('Please select...'),
    1 => t('Approve Entire Case Study Project'),
    2 => t('Resubmit Project files'),
    3 => t('Dis-Approve Entire Case Study Project (This will delete the project)'),
  ];
}

/**
 * Returns rendered bulk-review details for a proposal.
 */
function _case_study_details($proposal_id) {
  $proposal = upgradation_load_proposal($proposal_id);
  if (!$proposal) {
    return '';
  }

  $files = upgradation_get_uploaded_file_records($proposal_id);
  $download_link = Link::fromTextAndUrl(t('Download Case Study Project'), Url::fromRoute('upgradation.download_full_project', ['proposal_id' => $proposal_id]))->toString();

  $markup = '<div class="upgradation-bulk-details">';
  $markup .= '<p><strong>' . t('Proposer Name') . ':</strong><br>' . Html::escape($proposal->name_title . ' ' . $proposal->contributor_name) . '</p>';
  $markup .= '<p><strong>' . t('Title of the Case Study Project') . ':</strong><br>' . Html::escape($proposal->project_title) . '</p>';
  $markup .= '<p><strong>' . t('Uploaded abstract of the project') . ':</strong><br>' . Html::escape($files['A']->filename ?? t('File not uploaded')) . '</p>';
  $markup .= '<p><strong>' . t('Uploaded Case Directory') . ':</strong><br>' . Html::escape($files['S']->filename ?? t('File not uploaded')) . '</p>';
  $markup .= '<p><strong>' . t('Uploaded All Run File') . ':</strong><br>' . Html::escape($files['R']->filename ?? t('File not uploaded')) . '</p>';
  $markup .= '<p>' . $download_link . '</p>';
  $markup .= '</div>';

  return $markup;
}

/**
 * Renames a proposal directory if it exists.
 */
function CSU_RenameDir($proposal_id, $dir_name) {
  $proposal = upgradation_load_proposal($proposal_id);
  if (!$proposal) {
    \Drupal::messenger()->addError(t('Proposal data not found.'));
    return FALSE;
  }

  $old_path = upgradation_get_proposal_absolute_path($proposal);
  if (!is_dir($old_path)) {
    return TRUE;
  }

  $target = dirname(rtrim($old_path, '/')) . '/' . $dir_name . '/';
  if (@rename($old_path, $target)) {
    return TRUE;
  }

  \Drupal::messenger()->addError(t('Directory could not be renamed.'));
  return FALSE;
}

/**
 * Deletes a proposal directory recursively.
 */
function csu_rrmdir_project($proposal_id) {
  $proposal = upgradation_load_proposal($proposal_id);
  if (!$proposal) {
    return FALSE;
  }

  $directory = upgradation_get_proposal_absolute_path($proposal);
  if (!is_dir($directory)) {
    return TRUE;
  }

  return upgradation_delete_directory_recursive($directory);
}

/**
 * Recursively deletes a directory.
 */
function upgradation_delete_directory_recursive($directory) {
  if (!is_dir($directory)) {
    return TRUE;
  }

  $items = scandir($directory);
  foreach ($items as $item) {
    if ($item === '.' || $item === '..') {
      continue;
    }

    $path = $directory . '/' . $item;
    if (is_dir($path)) {
      if (!upgradation_delete_directory_recursive($path)) {
        return FALSE;
      }
    }
    else {
      if (!@unlink($path)) {
        return FALSE;
      }
    }
  }

  return @rmdir($directory);
}

/**
 * Deletes a fully uploaded project and its database rows.
 */
function upgradation_abstract_delete_project($proposal_id) {
  $proposal = upgradation_load_proposal($proposal_id);
  if (!$proposal) {
    \Drupal::messenger()->addError(t('Invalid Case Study Project.'));
    return FALSE;
  }

  csu_rrmdir_project($proposal_id);
  \Drupal::database()->delete('csu_submitted_abstracts_file')->condition('proposal_id', $proposal_id)->execute();
  \Drupal::database()->delete('csu_submitted_abstracts')->condition('proposal_id', $proposal_id)->execute();
  \Drupal::database()->delete('csu_proposal')->condition('id', $proposal_id)->execute();
  return TRUE;
}

/**
 * Creates a README file in the uploaded project directory.
 */
function CreateReadmeFileUpgradedCaseStudyProject($proposal_id) {
  $proposal = upgradation_load_proposal($proposal_id);
  if (!$proposal) {
    return '';
  }

  $directory = upgradation_ensure_proposal_directory($proposal);
  $readme_path = $directory . 'README.txt';
  $content = [];
  $content[] = 'About the Case Study';
  $content[] = '';
  $content[] = 'Title Of The Case Study Project: ' . $proposal->project_title;
  $content[] = 'Contributor Name: ' . $proposal->name_title . ' ' . $proposal->contributor_name;
  $content[] = 'University: ' . $proposal->university;
  $content[] = '';
  $content[] = 'Case Study Project By FOSSEE, IIT Bombay';
  $text = implode(PHP_EOL, $content) . PHP_EOL;

  file_put_contents($readme_path, $text);
  return $text;
}
